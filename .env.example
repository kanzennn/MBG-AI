# Kaggle (dataset download)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# Ingest worker (`python main.py ingest`) — see ingest/config.py
# Same MongoDB Argus v3 writes its sentimen documents to (sentimen_x /
# sentimen_instagram / sentimen_tiktok, collection posts_with_comments) —
# copy the value from ARGUS_V3/.env's MONGODB_URL. On a host where both run
# inside the same Docker network, use that network's Mongo hostname instead
# of a public IP.
MONGODB_URL=mongodb://user:password@host:27017/
PAWONWARGA_BASE_URL=http://localhost:8080
PAWONWARGA_API_KEY=change-this-ingest-api-key

# Optional — defaults shown
# INGEST_MODEL_DIR=model_output_tweet/best
# INGEST_MODEL_VERSION=indobertweet-v1
# INGEST_BATCH_PAGE_SIZE=50
# INGEST_LOG_FILE=logs/ingest.log
